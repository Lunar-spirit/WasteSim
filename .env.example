DATABASE_URL=postgresql+asyncpg://swms:swms@localhost:5432/swms
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development

# Comma-separated origins allowed to call the API from a browser (CORS).
# The default already covers Vite's dev server (frontend/).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional (module M15, the chatbot). Leave unset/blank to use the built-in
# deterministic keyword matcher instead of a real LLM — the chat feature
# works fully either way, per EXT-05.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Automation module (auto-populate: roads/rainfall/terrain from OSM,
# Open-Meteo and Open-Elevation). All three are free public APIs with no
# key required — these defaults work as-is. Only override if you have a
# commercial/high-rate-tier endpoint or a self-hosted instance.
OPEN_METEO_API_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_API_KEY=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OPEN_ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup
GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
